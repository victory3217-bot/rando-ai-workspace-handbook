---
// English entry page (overview only). The chapters are not translated yet, so this page links to the
// Korean edition and never to an English chapter. When the first English chapter is released, English
// becomes a Starlight locale (see astro.config.mjs): delete this file then, because Starlight will
// serve /en/ itself.
import { PARTS } from "../../../handbook.config.mjs";
import manifest from "../../../../content-manifest.json";

const base = import.meta.env.BASE_URL;
const entries = manifest.entries;
const title = (id) => entries.find((e) => e.chapter_id === id && e.language === "en")?.title ?? id;
const parts = PARTS.filter((p) => p.dir !== "optional");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>AI Workspace Handbook — English overview</title>
		<meta
			name="description"
			content="A 14-chapter hands-on handbook that helps non-programmers build a personal AI work environment. The chapters are currently available in Korean; this page is an English overview."
		/>
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<style>
			:root { --navy: #14253d; --teal: #2f6f73; --sand: #f4f1ea; --line: #d9d4c7; --ink: #1f2a37; --muted: #566273; }
			* { box-sizing: border-box; }
			body { margin: 0; font: 17px/1.65 system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color: var(--ink); background: #fbfaf7; }
			a { color: var(--teal); }
			.bar { background: var(--navy); padding: 0.55rem 1rem; text-align: center; font-size: 0.9rem; }
			.bar a { color: #fff; font-weight: 600; text-decoration: none; }
			header.hero { background: var(--navy); color: #fff; padding: 2.5rem 1rem 2.75rem; }
			.wrap { max-width: 46rem; margin: 0 auto; padding: 0 1rem; }
			header.hero .wrap { padding: 0; }
			h1 { margin: 0 0 0.5rem; font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.2; }
			.lead { margin: 0; color: #cfd8e6; font-size: 1.1rem; }
			main { padding: 2rem 0 3rem; }
			h2 { margin: 2.25rem 0 0.75rem; font-size: 1.35rem; color: var(--navy); }
			.status { background: var(--sand); border: 1px solid var(--line); border-radius: 12px; padding: 1rem 1.25rem; }
			.status p { margin: 0.25rem 0; }
			.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.25rem 0 0; }
			.btn { display: inline-block; padding: 0.7rem 1.15rem; border-radius: 10px; font-weight: 600; text-decoration: none; border: 2px solid var(--navy); }
			.btn.primary { background: var(--navy); color: #fff; }
			.btn.secondary { background: #fff; color: var(--navy); }
			ul.chapters { list-style: none; margin: 0.25rem 0 0; padding: 0; }
			ul.chapters li { padding: 0.35rem 0; border-bottom: 1px solid var(--line); }
			ul.chapters .code { display: inline-block; min-width: 3.4rem; font-weight: 700; color: var(--teal); }
			h3 { margin: 1.25rem 0 0.25rem; font-size: 1.05rem; color: var(--navy); }
			.overview { margin: 1rem 0 0; }
			.overview img { width: 100%; max-width: 24rem; height: auto; display: block; border: 1px solid var(--line); border-radius: 12px; background: #fff; }
			.note { color: var(--muted); font-size: 0.95rem; }
			footer { border-top: 1px solid var(--line); padding: 1.25rem 0 2rem; color: var(--muted); font-size: 0.9rem; }
		</style>
	</head>
	<body>
		<div class="bar"><a href="https://magisglobal.co.kr/en/handbooks/"><span aria-hidden="true">←</span> Back to the Magis Global Handbooks</a></div>
		<header class="hero">
			<div class="wrap">
				<h1>AI Workspace Handbook</h1>
				<p class="lead">A hands-on handbook for non-programmers: connect your computer, cloud storage, AI tools, and work documents into a personal AI work environment, and finish one real task with it.</p>
			</div>
		</header>
		<main class="wrap">
			<div class="status" role="note">
				<p><strong>What is available now:</strong> the full handbook in <strong>Korean</strong> (14 chapters, workshop materials, instructor guide, glossary).</p>
				<p><strong>English edition:</strong> in preparation. This page is an English overview, not a translation of the chapters.</p>
				<div class="actions">
					<a class="btn primary" href={`${base}ko/`}>Read the Korean edition <span style="white-space:nowrap">(한국어)</span></a>
					<a class="btn secondary" href="https://github.com/victory3217-bot/rando-ai-workspace-handbook">GitHub repository</a>
				</div>
			</div>

			<h2>Who it is for</h2>
			<p>Office professionals with no programming experience. The goal is not to learn every AI feature, but to build a work environment you can actually use and complete one task with it.</p>

			<h2>How it works</h2>
			<p>You choose <em>one</em> candidate task (“task A”) in Chapter 1 and carry it through all 14 chapters. Each chapter's result becomes the next chapter's input: a map of your workspace, an information-handling review, a folder structure, storage and sharing rules, an AI project, a knowledge base, work instructions, a workflow, verification checks, and a backup plan. All practice uses fictional data.</p>

			<h2>Structure</h2>
			{parts.map((part) => (
				<>
					<h3>{part.label.en}</h3>
					<ul class="chapters">
						{part.chapters.map((id) => (
							<li><span class="code">{id.replace("AW-", "")}</span>{title(id)}</li>
						))}
					</ul>
				</>
			))}
			<p class="note">Chapter titles are shown in English for orientation. The chapter text itself is Korean for now.</p>

			<h2>At a glance</h2>
			<p class="overview"><a href={`${base}handbook-overview.en.svg`}><img src={`${base}handbook-overview.en.svg`} alt="Summary diagram: audience, goal, 4 parts and 14 chapters, cumulative practice flow, outputs, run types, and ways to use the handbook" loading="lazy" /></a></p>
			<p class="note">Tap the image to open the full-size SVG.</p>
		</main>
		<footer>
			<div class="wrap">Magis Global · AI Workspace Handbook. The examples are fictional. The handbook is not legal or security advice, and your organization's rules come first.</div>
		</footer>
	</body>
</html>
